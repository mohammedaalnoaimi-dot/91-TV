<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="NfBtn">
        <item name="android:background">@drawable/ctl_focus</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">8dp</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Dialog91" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#EBDDC4</item>
        <item name="android:textColorSecondary">#A8977E</item>
        <item name="android:colorAccent">#C9475C</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/dialog_item</item>
        <item name="android:selectableItemBackground">@drawable/dialog_item</item>
    </style>
</resources>
