<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list>
        <item><shape android:shape="rectangle"><solid android:color="#33C9475C"/><corners android:radius="6dp"/></shape></item>
        <item><shape android:shape="rectangle"><stroke android:width="1.5dp" android:color="#C9475C"/><corners android:radius="6dp"/></shape></item>
    </layer-list></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#33C9475C"/><corners android:radius="6dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000"/></shape></item>
</selector>
